# --- Database (Postgres) ----------------------------------------------------
# The app uses the Supabase connection pooler (port 6543) on serverless hosts.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432), used by `prisma migrate deploy` / `db push`.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (attachments) -----------------------------------------
# Project Settings -> API. The service role key is server-only; never expose it.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="attachments"

# --- App --------------------------------------------------------------------
# Absolute base URL (your Vercel domain); used for OAuth/SSO callbacks.
APP_BASE_URL="https://your-app.vercel.app"

# Secret used to sign the session cookie (HMAC). Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Jira Cloud OAuth 2.0 (3LO) --------------------------------------------
# Jira is optional and disabled by default. Set JIRA_ENABLED="true" (plus
# credentials) to turn on the Jira integration.
JIRA_ENABLED="false"
# Create an app at https://developer.atlassian.com/console/myapps/
#   1. Add "OAuth 2.0 (3LO)" and set the callback URL to:
#        ${APP_BASE_URL}/api/jira/oauth/callback
#   2. Permissions: Jira platform REST API -> read:jira-work, read:jira-user,
#      write:jira-work (to post result comments and create bugs); plus
#      "offline_access" so we can refresh tokens.
#   3. Copy the Client ID and Secret below.
JIRA_CLIENT_ID=""
JIRA_CLIENT_SECRET=""
# Secret for the inbound webhook (/api/jira/webhook). Leave blank to disable.
JIRA_WEBHOOK_SECRET=""
# Secret for the embedded-panel coverage API (/api/v1/jira/coverage).
JIRA_PANEL_SECRET=""

# --- Seeding (optional) -----------------------------------------------------
# Used by `npm run db:seed` to create the first admin. If SEED_ADMIN_PASSWORD
# is omitted, a random password is generated and printed once.
# SEED_ADMIN_EMAIL="admin@testhub.dev"
# SEED_ADMIN_PASSWORD=""
